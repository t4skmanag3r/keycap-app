{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "keycap-app",
    "version": "0.2.0"
  },
  "tauri": {
    "systemTray": {
      "iconPath": "icons/keycap-icon-01.png",
      "iconAsTemplate": true
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "process": {
        "all": false,
        "exit": true,
        "relaunch": false,
        "relaunchDangerousAllowSymlinkMacos": false
      }
    },
    "cli": {
      "args": [
        {
          "name": "autolaunch",
          "short": "a",
          "takesValue": false
        }
      ]
    },
    "windows": [
      {
        "title": "keycap",
        "width": 1400,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.keycap-app.app",
      "icon": ["icons/keycap-icon-01.png", "icons/icon.ico"]
    }
  }
}
